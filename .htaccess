# OVH Apache/static hosting rules. GitHub Pages ignores this file.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Prevent HTTP/2 connection reuse from serving the static site on the legacy
  # WordPress host. Browsers should retry the request on the correct vhost.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?ancien\.cognac-leopold-croizet\.com$ [NC]
  RewriteRule ^ - [R=421,L]

  # Keep one indexable host and protocol for search engines and AI agents.
  RewriteCond %{HTTP_HOST} !^cognac-leopold-croizet\.com$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(?:www\.)?ancien\.cognac-leopold-croizet\.com$ [NC]
  RewriteRule ^ https://cognac-leopold-croizet.com%{REQUEST_URI} [R=301,L]

  # OVH sometimes misses the directory index for this newly created locale page.
  RewriteRule ^zh/faq/?$ zh/faq/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 5 minutes"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|mjs|jpg|jpeg|png|gif|svg|webp|avif|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:xml|txt|json|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
