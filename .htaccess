# OVH Apache/static hosting rules. GitHub Pages ignores this file.
Options -Indexes

<IfModule mod_setenvif.c>
  # The historical WordPress host must stay accessible but must not become an
  # indexable copy of the new static site if OVH routing ever drifts.
  SetEnvIfNoCase Host "^(www\.)?ancien\.cognac-leopold-croizet\.com$" legacy_wordpress_host=1
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Prevent HTTP/2 connection reuse from serving the static site on the legacy
  # WordPress host. Browsers should retry the request on the correct vhost.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?ancien\.cognac-leopold-croizet\.com$ [NC]
  RewriteRule ^ - [R=421,L]

  # Retire legacy WPML language subdomains without losing language intent.
  # These hosts must consolidate into the canonical path-based locales.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?en\.cognac-leopold-croizet\.com$ [NC]
  RewriteCond %{REQUEST_URI} ^/en(?:/|$) [NC]
  RewriteRule ^ https://cognac-leopold-croizet.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?en\.cognac-leopold-croizet\.com$ [NC]
  RewriteRule ^ https://cognac-leopold-croizet.com/en%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?ru\.cognac-leopold-croizet\.com$ [NC]
  RewriteCond %{REQUEST_URI} ^/ru(?:/|$) [NC]
  RewriteRule ^ https://cognac-leopold-croizet.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?ru\.cognac-leopold-croizet\.com$ [NC]
  RewriteRule ^ https://cognac-leopold-croizet.com/ru%{REQUEST_URI} [R=301,L]

  # Keep one indexable host and protocol for search engines and AI agents.
  RewriteCond %{HTTP_HOST} !^cognac-leopold-croizet\.com$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(?:www\.)?ancien\.cognac-leopold-croizet\.com$ [NC]
  RewriteRule ^ https://cognac-leopold-croizet.com%{REQUEST_URI} [R=301,L]

  # Retire legacy WPML query-language URLs from search-engine indexes.
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$) [NC]
  RewriteRule ^$ / [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=fr(&|$) [NC]
  RewriteRule ^(.+)$ /$1 [R=301,L,QSD]

  RewriteCond %{QUERY_STRING} (^|&)lang=(en|ru|da|sv|no)(&|$) [NC]
  RewriteRule ^$ /%2/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=(zh|zh-cn)(&|$) [NC]
  RewriteRule ^$ /zh/ [R=301,L,QSD]

  RewriteCond %{QUERY_STRING} (^|&)lang=(en|ru|da|sv|no)(&|$) [NC]
  RewriteRule ^(le-temps|la-matiere|lalchimie|le-feu|leopold-croizet|rencontre|pierre-croizet-cocktails|film-maison-leopold-croizet)/?$ /%2/$1/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=(zh|zh-cn)(&|$) [NC]
  RewriteRule ^(le-temps|la-matiere|lalchimie|le-feu|leopold-croizet|rencontre|pierre-croizet-cocktails|film-maison-leopold-croizet)/?$ /zh/$1/ [R=301,L,QSD]

  RewriteCond %{QUERY_STRING} (^|&)lang=(en|ru|da|sv|no)(&|$) [NC]
  RewriteRule ^collection/([^/]+)/?$ /%2/collection/$1/ [R=301,L,QSD]
  RewriteCond %{QUERY_STRING} (^|&)lang=(zh|zh-cn)(&|$) [NC]
  RewriteRule ^collection/([^/]+)/?$ /zh/collection/$1/ [R=301,L,QSD]

  # Preserve legacy product shortcuts discovered by Yandex as clean canonical URLs.
  RewriteRule ^heritage/?$ /collection/heritage/ [R=301,L,QSD]
  RewriteRule ^en/heritage/?$ /en/collection/heritage/ [R=301,L,QSD]
  RewriteRule ^ru/heritage/?$ /ru/collection/heritage/ [R=301,L,QSD]
  RewriteRule ^da/heritage/?$ /da/collection/heritage/ [R=301,L,QSD]
  RewriteRule ^sv/heritage/?$ /sv/collection/heritage/ [R=301,L,QSD]
  RewriteRule ^no/heritage/?$ /no/collection/heritage/ [R=301,L,QSD]
  RewriteRule ^zh/heritage/?$ /zh/collection/heritage/ [R=301,L,QSD]

  # Retire temporary authority-kit technical-sheet URLs without creating 404s.
  RewriteRule ^assets/authority/dossier-de-presse-cognac-leopold-croizet\.pdf$ /dossier-de-presse/ [R=301,L,QSD]
  RewriteRule ^assets/authority/fiches-techniques/([^/.]+)\.pdf$ /collection/$1/ [R=301,L,QSD]
  RewriteRule ^fiches-techniques/?$ /collection/ [R=301,L,QSD]
  RewriteRule ^(en|da|sv|no|zh)/fiches-techniques/?$ /$1/shop/ [R=301,L,QSD]
  RewriteRule ^ru/fiches-techniques/?$ /ru/a-faire/ [R=301,L,QSD]
  RewriteRule ^fiches-techniques/([^/]+)/?$ /collection/$1/ [R=301,L,QSD]
  RewriteRule ^(en|ru|da|sv|no|zh)/fiches-techniques/([^/]+)/?$ /$1/collection/$2/ [R=301,L,QSD]

  # OVH sometimes misses the directory index for this newly created locale page.
  RewriteRule ^zh/faq/?$ zh/faq/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, follow, noarchive" env=legacy_wordpress_host
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 5 minutes"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|mjs|jpg|jpeg|png|gif|svg|webp|avif|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:xml|txt|json|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
